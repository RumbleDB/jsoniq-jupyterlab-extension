{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022", "DOM"],
        "module": "ES2022",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "sourceMap": true,
        "strict": true,
        "outDir": "dist/lib",
        "rootDir": "src",
        "incremental": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}
