{
    "name": "jsoniq-jupyterlab-extension",
    "version": "2.0.0",
    "description": "JupyterLab extension for JSONiq: highlighting and a language server for %%jsoniq cells and .jq files.",
    "keywords": [
        "jsoniq"
    ],
    "homepage": "https://github.com/RumbleDB/jsoniq-jupyterlab-extension#readme",
    "bugs": {
        "url": "https://github.com/RumbleDB/jsoniq-jupyterlab-extension/issues"
    },
    "license": "Apache-2.0",
    "author": "JSONiq Development Team",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RumbleDB/jsoniq-jupyterlab-extension.git"
    },
    "style": "style/index.css",
    "files": [
        "dist/images/",
        "dist/lib/",
        "dist/labextension/",
        "style/",
        "schema/"
    ],
    "main": "dist/lib/plugin.js",
    "scripts": {
        "build:lib": "tsc --sourceMap",
        "build:lib:prod": "tsc",
        "build:labextension": "jupyter labextension build .",
        "build:labextension:dev": "jupyter labextension build --development True .",
        "build": "run-s build:lib copy:assets copy:server build:labextension:dev",
        "build:prod": "run-s build:lib:prod copy:assets copy:server build:labextension",
        "copy:assets": "shx mkdir -p dist/images && shx cp images/* dist/images/",
        "copy:server": "node scripts/vendor-language-server.mjs",
        "watch": "run-p watch:src watch:labextension",
        "watch:src": "tsc -w --sourceMap",
        "watch:labextension": "jupyter labextension watch .",
        "sync:grammars": "shx cp ../jsoniq-lsp/packages/vscode-extension/syntaxes/jsoniq.tmLanguage.json ../jsoniq-lsp/packages/vscode-extension/syntaxes/xquery.tmLanguage.json src/syntaxes/",
        "test": "vitest run tests",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "changeset": "changeset",
        "release:version": "changeset version"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.13.1",
        "@codemirror/lsp-client": "^6.3.0",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@jupyterlab/application": "^4.6.6",
        "@jupyterlab/cells": "^4.6.6",
        "@jupyterlab/codeeditor": "^4.6.6",
        "@jupyterlab/codemirror": "^4.6.6",
        "@jupyterlab/completer": "^4.6.6",
        "@jupyterlab/coreutils": "^6.6.6",
        "@jupyterlab/fileeditor": "^4.6.6",
        "@jupyterlab/notebook": "^4.6.6",
        "@jupyterlab/services": "^7.6.6",
        "@jupyterlab/settingregistry": "^4.6.6",
        "@jupyterlab/statusbar": "^4.6.6",
        "@jupyterlab/ui-components": "^4.6.6",
        "@lezer/highlight": "^1.2.5",
        "@lumino/signaling": "^2.1.6",
        "@lumino/widgets": "^2.10.0",
        "@shikijs/engine-javascript": "^4.6.0",
        "@shikijs/vscode-textmate": "^10.1.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^1.0.1",
        "@changesets/cli": "^3.0.3",
        "@jupyterlab/builder": "^4.5.11",
        "@types/node": "^26.6.6",
        "jsoniq-language-server": "^2.21.0",
        "npm-run-all2": "^9.0.4",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "shx": "^0.4.0",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    },
    "packageManager": "pnpm@12.21.0",
    "jupyterlab": {
        "extension": true,
        "outputDir": "dist/labextension",
        "schemaDir": "schema"
    }
}
